# ---------------------------------------------------------------------------
# Frappe backend
# ---------------------------------------------------------------------------
# Base URL of the bench site running the `techinc_website` app. No trailing
# slash. Must be reachable from Vercel's servers — a *.localhost address works
# locally but will fail in production.
FRAPPE_URL=https://erp.techincglobal.com

# API key/secret for a Frappe user holding the "Website Manager TI" role.
# Generate in Frappe: User -> Settings -> API Access -> Generate Keys.
FRAPPE_API_KEY=
FRAPPE_API_SECRET=

# Must match Website Settings TI -> Intake secret in Frappe. Guards the
# guest-allowed intake methods; rotate in both places at the same time.
WEBSITE_INTAKE_SECRET=

# ---------------------------------------------------------------------------
# On Vercel: set all four under Project -> Settings -> Environment Variables for
# the Production environment, then redeploy. They are read at request time, so a
# value added after a build still needs a redeploy to reach the function.
# ---------------------------------------------------------------------------
