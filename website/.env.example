# Frappe backend. Point at the bench site that has `techinc_website` installed.
FRAPPE_URL=http://develop.localhost:8000

# API key/secret for a Frappe user with the "Website Manager" role.
# Generate in Frappe: User -> API Access -> Generate Keys.
FRAPPE_API_KEY=
FRAPPE_API_SECRET=

# Shared secret, must match Website Settings TI -> intake_secret in Frappe.
# Guards the guest-allowed intake methods.
WEBSITE_INTAKE_SECRET=
