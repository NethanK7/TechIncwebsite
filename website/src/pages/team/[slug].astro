---
import Page from '@/layouts/Page.astro'
import { getCollection } from 'astro:content'
import { TEAM, COMPANY } from '@/lib/data/company'
import { personSchema } from '@/lib/seo'
import type { GetStaticPaths } from 'astro'

export const getStaticPaths = (() =>
  TEAM.map((member) => ({
    params: { slug: member.slug },
    props: { member },
  }))) satisfies GetStaticPaths

const { member } = Astro.props

const posts = (await getCollection('blog', (p) => !p.data.draft && p.data.author === member.slug)).sort(
  (a, b) => b.data.published.getTime() - a.data.published.getTime(),
)

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })
---

<Page
  title={member.name}
  heading={member.name}
  eyebrow={member.role}
  intro={member.bio}
  description={`${member.name}, ${member.role} at ${COMPANY.name} — Sri Lanka's #1 Frappe Partner. ${member.bio}`}
  path={`/team/${member.slug}`}
  breadcrumb={member.name}
  parents={[{ label: 'About', href: '/about' }]}
  schema={[personSchema(member)]}
  ctaSource={`team:${member.slug}`}
  image={member.image}
>
  <div slot="head-extra">
    <div class="plate" aria-hidden="true">
      {member.image ? (
        <img
          src={member.image}
          alt={member.name}
          class="plate__img"
          style={member.imagePosition ? `--pos: ${member.imagePosition}` : undefined}
          width="136"
          height="136"
        />
      ) : (
        <span>{member.initials}</span>
      )}
    </div>
  </div>

  <section class="section">
    <div class="shell">
      <header class="posts__head" data-reveal>
        <p class="eyebrow">Writing</p>
        <h2 class="h3">
          {posts.length > 0 ? `Posts by ${member.name.split(' ')[0]}` : `Nothing published yet`}
        </h2>
      </header>

      {
        posts.length > 0 ? (
          <ul class="posts" data-reveal-group>
            {posts.map((post) => (
              <li data-reveal>
                <a class="post" href={`/blog/${post.id}`}>
                  <div class="post__meta">
                    <span class="eyebrow">{post.data.topic}</span>
                    <time class="mono post__date" datetime={post.data.published.toISOString()}>
                      {fmt(post.data.published)}
                    </time>
                  </div>
                  <div class="post__main">
                    <h3 class="h4 post__title">{post.data.title}</h3>
                    <p class="post__desc">{post.data.description}</p>
                    <span class="mono post__read">{post.data.readingMinutes} min read →</span>
                  </div>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="empty" data-reveal>
            {member.name.split(' ')[0]} hasn't published on the blog yet — posts written under this
            profile will appear here.
          </p>
        )
      }
    </div>
  </section>
</Page>

<style>
  .plate {
    display: grid;
    place-items: center;
    width: clamp(7rem, 11vw, 8.5rem);
    height: clamp(7rem, 11vw, 8.5rem);
    margin-top: clamp(var(--s-6), 4vw, var(--s-10));
    border-radius: 999px;
    background: var(--ink);
    color: var(--paper-pure);
    font-family: var(--font-mono);
    font-size: var(--t-h3);
    letter-spacing: 0.02em;
    overflow: hidden;
    border: 1px solid var(--hair);
    box-shadow: 0 8px 28px -8px rgb(11 13 24 / 0.12);
  }

  .plate:has(.plate__img) {
    background: #f8fafc;
  }

  .plate__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--pos, center 40%);
    transform-origin: var(--pos, center 40%);
    transform: scale(1.36);
    display: block;
  }

  .posts__head {
    max-width: 40ch;
  }

  .posts {
    margin-top: clamp(var(--s-8), 4vw, var(--s-12));
    border-top: 1px solid var(--hair);
  }

  .post {
    display: grid;
    grid-template-columns: minmax(0, 14rem) minmax(0, 1fr);
    gap: var(--s-8);
    padding: clamp(var(--s-6), 3vw, var(--s-10)) 0;
    border-bottom: 1px solid var(--hair);
    transition:
      padding-left var(--dur) var(--ease-out),
      background var(--dur) var(--ease-out);
  }

  .post:hover {
    padding-left: var(--s-5);
    background: var(--paper-pure);
  }

  .post__meta {
    display: grid;
    gap: var(--s-2);
    align-content: start;
  }

  .post__date {
    color: var(--ink-faint);
  }

  .post__title {
    max-width: 30ch;
  }

  .post__desc {
    margin-top: var(--s-4);
    color: var(--ink-dim);
    max-width: 60ch;
  }

  .post__read {
    display: inline-block;
    margin-top: var(--s-5);
    color: var(--ink-faint);
    transition: color var(--dur-fast) var(--ease-out);
  }

  .post:hover .post__read {
    color: var(--ink);
  }

  .empty {
    margin-top: clamp(var(--s-8), 4vw, var(--s-12));
    color: var(--ink-dim);
    max-width: 48ch;
  }

  @media (max-width: 760px) {
    .post {
      grid-template-columns: 1fr;
      gap: var(--s-4);
    }
    .post__meta {
      grid-auto-flow: column;
      justify-content: start;
      gap: var(--s-4);
      align-items: center;
    }
  }
</style>
