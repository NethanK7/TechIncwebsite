---
import Page from '@/layouts/Page.astro'
import Faq from '@/components/ui/Faq.astro'
import { SERVICES, INDUSTRIES, FAQ_GENERAL, COMPANY } from '@/lib/data/company'
import { serviceSchema } from '@/lib/seo'
import type { GetStaticPaths } from 'astro'

export const getStaticPaths = (() =>
  SERVICES.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }))) satisfies GetStaticPaths

const { service } = Astro.props
const others = SERVICES.filter((s) => s.slug !== service.slug).slice(0, 4)

const serviceFaq = service.faq?.length
  ? service.faq
  : [
      {
        q: `Who provides ${service.name.toLowerCase()} in Sri Lanka?`,
        a: `${COMPANY.name} provides ${service.name} in Sri Lanka. It is the country's first and only authorized ${COMPANY.partnerOf} partner, holding ${COMPANY.partnerStatus} status, with more than 30 Frappe ERP implementations delivered since 2018.`,
      },
      ...FAQ_GENERAL.slice(0, 4),
    ]

const facts = service.whyUs?.stats || [
  { label: 'DELIVERY', value: '12-week standard programme' },
  { label: 'METHODOLOGY', value: 'NXTGEN Agile, up to 40% faster' },
  { label: 'EXPERIENCE', value: '30+ ERP implementations' },
  { label: 'HAPPY CUSTOMERS', value: 'Long-term customer relationships' },
]
---

<Page
  title={`${service.name} in Sri Lanka — Techincglobal`}
  heading={service.name}
  eyebrow="Service"
  intro={service.summary}
  description={`${service.summary} Delivered by Techincglobal, Sri Lanka's official Frappe partner.`}
  path={`/services/${service.slug}`}
  breadcrumb={service.name}
  parents={[{ label: 'Services', href: '/services' }]}
  schema={[serviceSchema(service)]}
  ctaSource={`service:${service.slug}`}
>
  <section class="section">
    <div class="shell split">
      <div class="split__main" data-reveal>
        {
          service.overview && (
            <div class="service-overview">
              {service.overview.split('\n\n').map((p) => (
                <p class="prose split__body">{p}</p>
              ))}
            </div>
          )
        }

        {
          service.involves && (
            <div class="involves-section">
              <h2 class="h3 involves__title">
                {service.slug === 'erpnext-implementation'
                  ? 'What does an ERPNext implementation involve?'
                  : `What does ${service.name.toLowerCase()} involve?`}
              </h2>
              {service.involves.lead.split('\n\n').map((p) => (
                <p class="prose split__body">{p}</p>
              ))}

              {service.involves.items && service.involves.items.length > 0 && (
                <ul class="involves__items">
                  {service.involves.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              )}

              {service.involves.note && (
                <p class="prose split__body involves__note">{service.involves.note}</p>
              )}
            </div>
          )
        }

        {
          service.whatWeDo && service.whatWeDo.length > 0 && (
            <div class="what-we-do">
              <h2 class="h3 split__sub">What we do</h2>
              <ol class="steps-list">
                {service.whatWeDo.map((step, idx) => (
                  <li class="step-card">
                    <div class="step-card__num mono">0{idx + 1}</div>
                    <div class="step-card__content">
                      <h3 class="h4 step-card__title">{step.title}</h3>
                      <p class="step-card__body">{step.body}</p>
                    </div>
                  </li>
                ))}
              </ol>
            </div>
          )
        }

        <div class="deliverables-section">
          <h2 class="h3 split__sub">What you get</h2>
          <ul class="deliverables">
            {service.deliverables.map((d) => <li>{d}</li>)}
          </ul>
        </div>

        {
          service.timeline && (
            <div class="timeline-callout">
              <h2 class="h3 timeline-callout__title">{service.timeline.headline}</h2>
              <p class="prose split__body">{service.timeline.lead}</p>
              {service.timeline.note && (
                <p class="prose split__body timeline-callout__note">{service.timeline.note}</p>
              )}
            </div>
          )
        }
      </div>

      <aside class="split__aside" data-reveal>
        <div class="panel">
          <p class="eyebrow">{service.whyUs?.eyebrow || 'Why us'}</p>
          <h3 class="h4">{service.whyUs?.title || 'Why Techincglobal?'}</h3>
          <p class="panel__text">
            {service.whyUs?.lead ||
              'Techincglobal combines ERPNext implementation expertise with local knowledge of how Sri Lankan businesses operate. As the only official Frappe partner in Sri Lanka and a Certified Bronze Partner, we understand both the platform and the practical realities of putting it to work.'}
          </p>
          <dl class="panel__facts">
            {
              facts.map((f) => (
                <div>
                  <dt>{f.label}</dt>
                  <dd>{f.value}</dd>
                </div>
              ))
            }
          </dl>
          <a class="btn btn--solid" href="/contact" data-cta={`service:${service.slug}:consultation`}>
            Discuss this service
          </a>
        </div>
      </aside>
    </div>
  </section>

  <!-- FAQ Section -->
  <Faq items={serviceFaq} title="Things you may want to know" />

  <section class="section section--tight related">
    <div class="shell">
      <h2 class="h3" data-reveal>Industries we support</h2>
      <ul class="chips" data-reveal>
        {
          INDUSTRIES.map((i) => (
            <li>
              <a class="chip" href={`/industries/${i.slug}`}>{i.name}</a>
            </li>
          ))
        }
      </ul>

      <div class="related__next" data-reveal>
        <h2 class="h3">Related services</h2>
        {
          service.relatedServicesIntro && (
            <p class="prose split__body related__intro">{service.relatedServicesIntro}</p>
          )
        }
      </div>
      <ul class="rel-list" data-reveal-group>
        {
          others.map((s) => (
            <li data-reveal>
              <a class="rel" href={`/services/${s.slug}`}>
                <span class="h4">{s.name}</span>
                <span class="rel__body">{s.summary}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Page>

<style>
  .split {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: clamp(var(--s-8), 5vw, var(--s-20));
    align-items: start;
  }

  .split__body {
    margin-top: var(--s-5);
    font-size: var(--t-lead);
    line-height: 1.5;
    color: var(--ink-2);
    max-width: 52ch;
  }

  .split__sub {
    margin-top: clamp(var(--s-10), 5vw, var(--s-16));
  }

  .involves__title {
    margin-top: clamp(var(--s-8), 4vw, var(--s-12));
  }

  .involves__items {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: var(--s-3);
    margin-top: var(--s-5);
    padding: 0;
    list-style: none;
  }

  .involves__items li {
    padding: var(--s-3) var(--s-4);
    background: var(--paper-pure);
    border: 1px solid var(--hair);
    border-radius: 0.5rem;
    font-size: var(--t-sm);
    color: var(--ink-2);
    display: flex;
    align-items: center;
    gap: var(--s-2);
  }

  .involves__items li::before {
    content: '—';
    color: var(--ink-faint);
  }

  .involves__note {
    margin-top: var(--s-4);
    font-style: italic;
    color: var(--ink-dim);
  }

  .steps-list {
    display: grid;
    gap: var(--s-5);
    margin-top: var(--s-6);
    padding: 0;
    list-style: none;
  }

  .step-card {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    gap: var(--s-4);
    padding: clamp(var(--s-4), 2.5vw, var(--s-6));
    background: var(--paper-pure);
    border: 1px solid var(--hair);
    border-radius: 0.875rem;
    box-shadow: var(--lift-1);
  }

  .step-card__num {
    font-size: var(--t-mono);
    color: var(--ink-faint);
    padding-top: 0.15em;
  }

  .step-card__title {
    font-size: var(--t-h4);
  }

  .step-card__body {
    margin-top: var(--s-2);
    font-size: var(--t-sm);
    color: var(--ink-dim);
    line-height: 1.5;
  }

  .timeline-callout {
    margin-top: clamp(var(--s-10), 5vw, var(--s-16));
    padding: clamp(var(--s-6), 4vw, var(--s-8));
    background: linear-gradient(145deg, var(--sky-100), var(--paper-pure));
    border: 1px solid var(--hair-strong);
    border-radius: 1rem;
  }

  .timeline-callout__title {
    font-size: var(--t-h3);
  }

  .timeline-callout__note {
    margin-top: var(--s-3);
    font-size: var(--t-sm);
    color: var(--ink-dim);
  }

  .related__intro {
    margin-top: var(--s-3);
    max-width: 54ch;
  }

  .deliverables {
    display: grid;
    gap: 0;
    margin-top: var(--s-6);
    border-top: 1px solid var(--hair);
  }

  .deliverables li {
    padding: var(--s-4) 0;
    border-bottom: 1px solid var(--hair);
    color: var(--ink-2);
    display: grid;
    grid-template-columns: 1.75rem 1fr;
  }

  .deliverables li::before {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    margin-top: 0.55em;
    border-radius: 50%;
    background: var(--ink);
  }

  /* Sticky sidebar: the proof panel should stay with the reader through a long
     deliverables list. */
  .split__aside {
    position: sticky;
    top: calc(var(--header-h) + var(--s-6));
  }

  .panel {
    display: grid;
    gap: var(--s-5);
    justify-items: start;
    padding: clamp(var(--s-6), 3vw, var(--s-8));
    background: var(--paper-pure);
    border: 1px solid var(--hair);
    border-radius: 1rem;
    box-shadow: var(--lift-1);
  }

  .panel__text {
    font-size: var(--t-sm);
    color: var(--ink-dim);
  }

  .panel__facts {
    display: grid;
    gap: var(--s-4);
    width: 100%;
    padding-top: var(--s-5);
    border-top: 1px solid var(--hair);
  }

  .panel__facts dt {
    font-family: var(--font-mono);
    font-size: var(--t-mono);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--ink-faint);
  }

  .panel__facts dd {
    margin-top: var(--s-1);
    font-size: var(--t-sm);
    font-weight: 500;
  }

  .related {
    border-top: 1px solid var(--hair);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin-top: var(--s-6);
  }

  .chip {
    display: inline-block;
    padding: 0.5em 1em;
    border-radius: 999px;
    border: 1px solid var(--hair-strong);
    font-size: var(--t-sm);
    color: var(--ink-2);
    transition:
      background var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }

  .chip:hover {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper-pure);
  }

  .related__next {
    margin-top: clamp(var(--s-12), 6vw, var(--s-20));
  }

  .rel-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 1px;
    background: var(--hair);
    border-block: 1px solid var(--hair);
    margin-top: var(--s-6);
  }

  .rel {
    display: grid;
    gap: var(--s-2);
    align-content: start;
    height: 100%;
    padding: var(--s-6);
    background: var(--paper);
    transition: background var(--dur) var(--ease-out);
  }

  .rel:hover {
    background: var(--paper-pure);
  }

  .rel__body {
    font-size: var(--t-sm);
    color: var(--ink-dim);
  }

  @media (max-width: 900px) {
    .split {
      grid-template-columns: 1fr;
    }
    .split__aside {
      position: static;
    }
  }
</style>
