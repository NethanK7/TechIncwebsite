---
import Page from '@/layouts/Page.astro'
import { SERVICES, FAQ_GENERAL } from '@/lib/data/company'
import { serviceSchema } from '@/lib/seo'
---

<Page
  title="Services — Techincglobal"
  heading="Services"
  eyebrow="SERVICES"
  intro="Techincglobal helps businesses get more from ERPNext, from implementation and customization to integration, automation, training, and ongoing support. Whether you are starting with ERPNext, modernizing an existing system, or looking to improve how your current implementation works, we can help you take the next step."
  description="Techincglobal helps businesses get more from ERPNext, from implementation and customization to integration, automation, training, and ongoing support."
  path="/services"
  breadcrumb="Services"
  schema={SERVICES.map(serviceSchema)}
  faq={FAQ_GENERAL.slice(0, 4)}
  ctaSource="services"
>
  <section class="section">
    <div class="shell">
      <ul class="cards" data-reveal-group>
        {
          SERVICES.map((s, i) => (
            <li data-reveal>
              <a class="card" href={`/services/${s.slug}`}>
                <span class="card__n mono">{String(i + 1).padStart(2, '0')}</span>
                <h2 class="h3 card__title">{s.name}</h2>
                <p class="card__summary">{s.cardSummary ?? s.summary}</p>
                <ul class="card__list">
                  {s.deliverables.slice(0, 3).map((d) => (
                    <li>{d}</li>
                  ))}
                </ul>
                <span class="card__go mono">Explore →</span>
              </a>
            </li>
          ))
        }
        <li data-reveal>
          <a class="card card--custom" href="/contact" data-cta="services:custom-solutions">
            <span class="card__n mono">09</span>
            <h2 class="h3 card__title">Tailored Frappe solutions</h2>
            <p class="card__summary">
              Have unique requirements or workflows not listed above? Techincglobal designs and builds bespoke enterprise solutions on Frappe and ERPNext.
            </p>
            <ul class="card__list">
              <li>Bespoke business workflows</li>
              <li>Custom application architecture</li>
              <li>Direct consultant advisory</li>
            </ul>
            <span class="card__go mono">Talk to our consultants →</span>
          </a>
        </li>
      </ul>
    </div>
  </section>
</Page>

<style>
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(21rem, 1fr));
    gap: 1px;
    background: var(--hair);
    border: 1px solid var(--hair);
    border-radius: 1rem;
    overflow: hidden;
  }

  .card {
    display: grid;
    align-content: start;
    gap: var(--s-3);
    height: 100%;
    padding: clamp(var(--s-6), 3vw, var(--s-10));
    background: var(--paper-pure);
    transition: background var(--dur) var(--ease-out);
  }

  .card:hover {
    background: var(--n-100);
  }

  .card--custom {
    background: linear-gradient(165deg, var(--paper-pure) 0%, rgb(240 245 252) 100%);
  }

  .card--custom:hover {
    background: linear-gradient(165deg, var(--paper-pure) 0%, rgb(232 240 250) 100%);
  }

  .card__n {
    color: var(--ink-faint);
  }

  .card__title {
    margin-top: var(--s-2);
    max-width: 18ch;
  }

  .card__summary {
    color: var(--ink-dim);
    font-size: var(--t-sm);
  }

  .card__list {
    display: grid;
    gap: var(--s-2);
    margin-top: var(--s-4);
    padding-top: var(--s-4);
    border-top: 1px solid var(--hair);
    font-size: var(--t-sm);
    color: var(--ink-dim);
  }

  .card__list li {
    display: grid;
    grid-template-columns: 1rem 1fr;
    gap: var(--s-2);
  }

  .card__list li::before {
    content: '—';
    color: var(--n-400);
  }

  .card__go {
    margin-top: var(--s-6);
    color: var(--ink-faint);
    transition: color var(--dur-fast) var(--ease-out);
  }

  .card:hover .card__go {
    color: var(--ink);
  }
</style>
