---
import Page from '@/layouts/Page.astro'
import Assessment from '@/components/islands/Assessment.tsx'
import { QUESTIONS } from '@/lib/data/assessment'
import { COMPANY } from '@/lib/data/company'
import { abs } from '@/lib/seo'
import '@/styles/forms.css'
import '@/styles/assessment.css'

const faq = [
  {
    q: 'What is the ERP readiness assessment?',
    a: `The ERP readiness assessment is a free ten-question tool from ${COMPANY.name} that scores how ready an organisation is to benefit from an ERP implementation now. It takes about five minutes, requires no email address to see the score, and returns a recommendation — including advising against proceeding when that is the honest answer.`,
  },
  {
    q: 'What does the readiness score measure?',
    a: 'The score measures readiness to benefit from an implementation now, not how much software you already own. A company running on spreadsheets with a committed owner-sponsor scores higher than one with a heavily customised legacy ERP and no internal sponsor, because sponsorship and internal capacity are the strongest predictors of success.',
  },
  {
    q: 'Is the assessment free?',
    a: 'Yes. It is free, needs no email address to see your result, and there is no obligation. Contact details are only requested if you want the reasoning written up and sent to you.',
  },
]

/** A WebApplication node: this is a tool, and describing it as one earns a
 *  richer result than a generic WebPage. */
const schema = [
  {
    '@type': 'WebApplication',
    '@id': `${abs('/assessment')}#tool`,
    name: 'ERP Readiness Assessment',
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Any',
    url: abs('/assessment'),
    description: `A free ${QUESTIONS.length}-question tool that scores how ready your organisation is for a Frappe ERP implementation.`,
    provider: { '@id': `${COMPANY.url}/#organization` },
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'LKR' },
    isAccessibleForFree: true,
  },
]
---

<Page
  title="ERP Readiness Assessment — Techincglobal"
  heading="How ready are you, really?"
  eyebrow="A free ERP readiness assessment"
  intro="Ten questions. About five minutes. An honest assessment of where your business stands today. You do not need to give us your email to see your result. We’ll show you your score, explain what it means, and suggest what we think you should do next. If the answer is not yet, we’ll tell you that too."
  description="A free 10-question ERP readiness assessment from Techincglobal, Sri Lanka's official Frappe partner. Get your score, the reasoning, and what to do next."
  path="/assessment"
  breadcrumb="ERP Readiness Assessment"
  schema={schema}
  faq={faq}
  ctaSource="assessment"
>
  <section class="section">
    <div class="shell">
      <Assessment client:load />
    </div>
  </section>

  <!-- The question set in static HTML. -->
  <section class="section section--tight questions">
    <div class="shell">
      <h2 class="h3" data-reveal>What the assessment asks</h2>
      <ol class="qlist" data-reveal-group>
        {
          QUESTIONS.map((q, i) => (
            <li data-reveal>
              <span class="qlist__n mono">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3 class="h4">{q.question}</h3>
                <p class="qlist__hint">{q.hint}</p>
              </div>
            </li>
          ))
        }
      </ol>

      <div class="after-assessment" data-reveal>
        <h2 class="h3">What happens after you finish?</h2>
        <p class="prose after-assessment__body">
          You get your readiness score immediately, along with an explanation of what is influencing it.
        </p>
        <p class="prose after-assessment__body">
          The assessment is not designed to tell everyone they are ready for ERP. Sometimes the right next step is to prepare your data, clarify your processes, get the right people involved, or simply wait until the business is ready.
        </p>
        <p class="prose after-assessment__body">
          If you are ready to move forward, we can talk through what an implementation could look like for your business.
        </p>
        <div class="after-assessment__action">
          <a class="btn btn--solid" href="/contact">Talk to us about your result</a>
        </div>
      </div>
    </div>
  </section>
</Page>

<style>
  .readiness-prep {
    padding: clamp(var(--s-6), 4vw, var(--s-10));
    background: var(--paper-pure);
    border: 1px solid var(--hair);
    border-radius: 1.25rem;
    box-shadow: var(--lift-1);
    max-width: 52rem;
  }

  .readiness-prep__lead {
    margin-top: var(--s-3);
    font-size: var(--t-body);
    line-height: 1.55;
    color: var(--ink-2);
  }

  .readiness-bullets {
    display: grid;
    gap: var(--s-2);
    margin-top: var(--s-5);
    padding: 0;
    list-style: none;
  }

  .readiness-bullets li {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    font-size: var(--t-sm);
    color: var(--ink-2);
  }

  .readiness-bullets li::before {
    content: '•';
    color: var(--ink-faint);
    font-size: 1.25em;
  }

  .questions { border-top: 1px solid var(--hair); }
  .qlist { margin-top: var(--s-8); border-top: 1px solid var(--hair); }
  .qlist li {
    display: grid; grid-template-columns: 3rem minmax(0, 1fr); gap: var(--s-5);
    padding: var(--s-5) 0; border-bottom: 1px solid var(--hair);
  }
  .qlist__n { color: var(--ink-faint); padding-top: 0.35em; }
  .qlist__hint { margin-top: var(--s-2); font-size: var(--t-sm); color: var(--ink-dim); max-width: 60ch; line-height: 1.5; }

  .after-assessment {
    margin-top: clamp(var(--s-12), 6vw, var(--s-20));
    padding: clamp(var(--s-6), 4vw, var(--s-10));
    background: linear-gradient(150deg, var(--paper-pure), var(--sky-100));
    border: 1px solid var(--hair-strong);
    border-radius: 1.25rem;
    max-width: 52rem;
  }

  .after-assessment__body {
    margin-top: var(--s-3);
    font-size: var(--t-body);
    line-height: 1.55;
    color: var(--ink-2);
  }

  .after-assessment__action {
    margin-top: var(--s-6);
  }
</style>
