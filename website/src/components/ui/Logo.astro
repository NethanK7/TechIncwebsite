---
/**
 * The TECHINCGLOBAL wordmark.
 *
 * Two paths rather than one: the letterforms inherit `currentColor` so the mark
 * works on any background, and the terminal full stop takes the accent. That
 * single coloured square is the only chromatic mark in the interface, which is
 * what makes it read as deliberate rather than decorative.
 */
import { LOGO_PATH, LOGO_VIEWBOX } from '@/lib/data/logo'

interface Props {
  /** Rendered height; width follows the intrinsic 1277:257 ratio. */
  height?: string
  class?: string
  /** Decorative when the mark sits next to text that already names us. */
  decorative?: boolean
  /** Render the full stop in `currentColor` too — for print and one-colour use. */
  mono?: boolean
}

const {
  height = '1.5rem',
  class: className = '',
  decorative = false,
  mono = false,
} = Astro.props
---

<svg
  class:list={['logo', className]}
  viewBox={LOGO_VIEWBOX}
  fill="currentColor"
  style={`height:${height}`}
  role={decorative ? 'presentation' : 'img'}
  aria-hidden={decorative ? 'true' : undefined}
  aria-label={decorative ? undefined : 'TECHINCGLOBAL'}
>
  {!decorative && <title>TECHINCGLOBAL</title>}
  <path fill-rule="evenodd" d={LOGO_PATH} />
</svg>

<style>
  .logo {
    width: auto;
    display: block;
    /* The mark's own shapes carry the weight; never let it get blurry. */
    shape-rendering: geometricPrecision;
  }

</style>
